{
  "name": "siakad-kdmp-blob",
  "version": "5.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "check": "node --check api/cloud-sync.js && node --check public/app.js",
    "secrets": "node scripts/generate-secrets.mjs",
    "check:connections": "node --env-file-if-exists=.env.local scripts/check-connections.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "acorn": "^8.19.0",
    "chart.js": "4.4.9",
    "dompurify": "^3.3.0",
    "tailwindcss": "3.4.17",
    "undici": "6.29.1"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
